<!DOCTYPE html>
<!-- Generated by build.py: edit data/ and templates/, not this file. -->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{% block title %}UK Unconferences{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="{% block description %}A year-by-year history of the UK's government and public sector unconferences.{% endblock %}" />
  <link rel="canonical" href="https://ukunconferences.org{{ url }}" />
  <link rel="stylesheet" href="/css/styles.css?v={{ ver }}" />
</head>
<body class="{% block body_class %}page{% endblock %}">

  <header class="site-header">
    <div class="site-header__inner">
      {% block masthead %}<p class="site-title"><a href="/">UK Unconferences</a></p>{% endblock %}
      <p class="site-tagline">A year-by-year history of the UK's government &amp; public sector unconferences.</p>
    </div>
  </header>

  {% block main %}{% endblock %}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__about">
        <p class="site-footer__by">Put together by Dave Durant from organisers' public pages and write-ups.</p>
        <p class="site-footer__note">Session lists give topics, not the names of the people who pitched them. Spotted a mistake, or want something about you changed or removed? <a href="mailto:dave@bowsy.co.uk">Email me</a>.</p>
      </div>
      <ul class="site-footer__links">
        <li><a href="https://bowsy.co.uk/" target="_blank" rel="noopener">bowsy.co.uk</a></li>
        <li><a href="https://bsky.app/profile/bowsy.co.uk" target="_blank" rel="noopener">Bluesky</a></li>
        <li><a href="https://www.linkedin.com/in/davidrdurant/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="mailto:dave@bowsy.co.uk">Email</a></li>
      </ul>
    </div>
  </footer>
{% block scripts %}{% endblock %}
</body>
</html>
